local function getCollectibles()
    local items = {}
    local myPos = getPlayerPosition()
    if not myPos then return items end

    local searchRoot = getSearchRoot()
    if not searchRoot then return items end

    local MAX_SEARCH_RADIUS = 1500
    local descendants = searchRoot:GetDescendants()

    for _, obj in ipairs(descendants) do
        if isPlayerCharacter(obj) then continue end
        if obj:IsA("BasePart") or (obj:IsA("Model") and not obj:FindFirstChild("Humanoid")) then
            local lowerName = obj.Name:lower()

            -- 排除玩家身体部件
            if lowerName == "humanoidrootpart" or lowerName:find("humanoid") or lowerName:find("torso") or lowerName:find("leg") or lowerName:find("arm") or lowerName:find("head") then
                continue
end

            -- 关键词匹配
            local nameMatch = false
            if #COLLECT_KEYWORDS == 0 then
                nameMatch = true
            else
                for _, kw in ipairs(COLLECT_KEYWORDS) do
                    if lowerName:find(kw) then
                        nameMatch = true
                        break
                    end
                end
            end
            if not nameMatch then continue end

            -- 获取位置
            local pos = nil
            if obj:IsA("BasePart") then
                pos = obj.Position
            elseif obj:IsA("Model") and obj:FindFirstChild("PrimaryPart") then
                pos = obj.PrimaryPart.Position
            elseif obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") then
                pos = obj.HumanoidRootPart.Position
            elseif obj:IsA("Model") and obj:FindFirstChildOfClass("BasePart") then
                pos = obj:FindFirstChildOfClass("BasePart").Position
            else
                continue
            end

            local dist = (myPos - pos).Magnitude
            if dist > MAX_SEARCH_RADIUS then continue end
            table.insert(items, {obj = obj, position = pos, distance = dist})
end
end
    return nearest
    return items
end

