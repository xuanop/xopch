local function performCollect(targetItem)
    if not targetItem or not targetItem.obj or not targetItem.obj.Parent then return false end
    local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local itemObj = targetItem.obj
    local originalParent = itemObj.Parent
    local originalPos = itemObj.Position

    if TELEPORT_TO_ITEM then
        hrp.CFrame = CFrame.new(targetItem.position + Vector3.new(0, 2, 0))
        task.wait(0.15)   -- 等待拾取判定
    else
        local humanoid = lp.Character:FindFirstChild("Humanoid")
        if humanoid then humanoid:MoveTo(targetItem.position) end
        task.wait(0.3)
    end

    -- 成功检测：物品消失 或 位置发生明显变化
    local stillExists = itemObj and itemObj.Parent and itemObj.Parent == originalParent
    local posChanged = stillExists and (itemObj.Position - originalPos).Magnitude > 0.1
    if not stillExists or posChanged then
        return true   -- 拾取成功
    else
        -- 可选调试：print("[自动收集] 拾取失败，物品仍在原处:", itemObj.Name)
        return false  -- 拾取失败，触发失败计数
    end
end

