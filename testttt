local function autoCollectLoop()
    if not autoCollectEnabled then return end
    if autoRescueEnabled and activeRescueTarget ~= nil then return end
    if currentCollecting then return end
    if not getPlayerPosition() then return end

    local now = os.clock()
    if now - lastCollectTime < COLLECT_COOLDOWN then return end
    if now < nextScanTime then return end
    nextScanTime = now + SCAN_INTERVAL

    local items = getCollectibles()
    hasCollectibleItems = (#items > 0)
    print("[调试] 扫描到物品数量:", #items)
    if #items == 0 then return end

    -- 过滤掉已成功拾取缓存中、永久黑名单中的物品
    local validItems = {}
    for _, item in ipairs(items) do
        local obj = item.obj
        -- 成功拾取缓存（10秒内不重复拾取）
        if collectedCache[obj] and now - collectedCache[obj] < 10 then
            -- 仍在冷却中
        elseif permanentlyIgnored[obj] then
            -- 已永久忽略
        else
            table.insert(validItems, item)
        end
    end

    if #validItems == 0 then
        if autoFarmEnabled then teleportToSky() end
        return
    end

    local myPos = getPlayerPosition()
    if not myPos then return end

    local bestItem = nil
    local bestDist = COLLECT_DISTANCE
    for _, item in ipairs(validItems) do
        local dist = item.distance or (myPos - item.position).Magnitude
        if dist < bestDist then
            bestDist = dist
            bestItem = item
        end
    end

    if bestItem then
        currentCollecting = true
        local success = performCollect(bestItem)
        if success then
            -- 拾取成功：清空失败计数，加入成功缓存，并从黑名单中移除（如果之前误加入）
            failCountCache[bestItem.obj] = nil
            permanentlyIgnored[bestItem.obj] = nil
            collectedCache[bestItem.obj] = now
            lastCollectTime = now
            nextScanTime = now + 0.05
            print("[自动收集] 拾取 " .. bestItem.obj.Name)
            if autoFarmEnabled then teleportToSky() end
        else
            -- 拾取失败：增加失败计数
            local currentFail = (failCountCache[bestItem.obj] or 0) + 1
            failCountCache[bestItem.obj] = currentFail
            if currentFail >= FAILED_THRESHOLD then
                permanentlyIgnored[bestItem.obj] = true
                print("[自动收集] 物品 " .. bestItem.obj.Name .. " 失败次数已达 " .. FAILED_THRESHOLD .. "，加入黑名单，永久忽略")
            else
                print("[自动收集] 拾取失败 (" .. currentFail .. "/" .. FAILED_THRESHOLD .. "): " .. bestItem.obj.Name)
end
            lastCollectTime = now
            nextScanTime = now + 0.5   -- 失败后稍长冷却
end
        print("==============================")
        currentCollecting = false
else
        warn("找不到 Events.Character")
        if autoFarmEnabled then teleportToSky() end
end
end)
